<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MGSPW_MC_Cheat_Trainer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MGSPW_MC_Cheat_Trainer.Views"
        xmlns:mgspwMcCheatTrainer="clr-namespace:MGSPW_MC_Cheat_Trainer"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="680"
        x:Class="MGSPW_MC_Cheat_Trainer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/trainer_icon.ico"
        Title="MGSPW MC Cheat Trainer"
        Height="680"
        Width="1240"
        MinHeight="680"
        MinWidth="1240">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Help"> 
                    <MenuItem Header="View Logs" x:Name="ViewLogsMenuItem" Click="ViewLogsMenuItem_OnClick"/>
                    <MenuItem Header="Open Install Location" Click="OpenInstallLocationMenuItem_Click"/>
                    <MenuItem Header="Download AutoUpdater" Click="DownloadAutoUpdaterMenuItem_Click"/>
                    <MenuItem Header="Visit GitHub Repo" Click="VisitGithubRepoMenuItem_Click"/>
                    <MenuItem Header="Join our Discord" x:Name="JoinDiscordMenuItem" Click="JoinDiscordMenuItem_OnClick"/>
                </MenuItem>
            </Menu>
            
            <Border DockPanel.Dock="Bottom"
                    BorderThickness="0,1,0,0"
                    BorderBrush = "{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    Padding="6,3">
                <TextBlock x:Name="StatusLabel" Text="Ready"/>
            </Border>
            
            <TabControl x:Name="MainTabControl"
                        SelectionChanged="MainTabControl_OnSelectionChanged">
                <TabItem x:Name="WeaponsTab" Header="R&amp;D Weapons">
                    <Panel>
                        <Image Source = "/Assets/rnd mock bg.png" Stretch="UniformToFill"/>
                        <views:WeaponsTabView/>
                    </Panel>
                </TabItem>
                
                <TabItem x:Name="ItemsTab" Header="R&amp;D Items">
                    <Panel>
                        <Image Source="/Assets/rnd_items_bg.png" Stretch="UniformToFill"/>
                        <views:ItemsTabView/>
                    </Panel>
                </TabItem>
                
                <TabItem x:Name="CheatsTab" Header="Cheats">
                    <Panel>
                        <Image Source="/Assets/title_bg.png" Stretch="UniformToFill"/>
                        <Rectangle Fill="Black" Opacity="0.7" IsHitTestVisible="False"/>
                        <views:CheatsTabView x:Name="VisibleCheatsTabView"/>
                    </Panel>
                </TabItem>
                
                <TabItem x:Name="OtherTab" Header="R&amp;D Other">
                    <Panel>
                        <Image Source="/Assets/rnd other.png" Stretch="UniformToFill"/>
                        <views:OtherTabView/>
                    </Panel>
                </TabItem>
                
                <TabItem x:Name="StaffTab" Header="Staff">
                    <TextBlock Text="UNDER CONSTRUCTION" Foreground="DarkGoldenrod" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="50"></TextBlock>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Panel>
</Window>
