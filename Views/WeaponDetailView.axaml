<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MGSPW_MC_Cheat_Trainer.Views.WeaponDetailView">
    
    <GroupBox x:Name="GroupBox" BorderBrush="Black">
        <Grid x:Name="ItemGrid" ColumnDefinitions=".5*,.5*" RowDefinitions=".5*,.5*">
            <Image x:Name="ObjectImage" Source="/Assets/handgun icon.png" Stretch="Uniform" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" HorizontalAlignment="Left"/>
            <Rectangle x:Name="ImageDarkener" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" 
            Fill="Black" Opacity="0.7" IsHitTestVisible="False"/>
            <CheckBox Grid.Row="0" Grid.Column="1" Content="Enabled" FontWeight="Bold" Foreground="White" Margin="4" Click="Enabled_OnClick"/>
            <Button Grid.Row="1" Grid.Column="0" Content="Level up" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="4" Padding="5,2" Click="LevelUp_OnClick"/>
            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="4" Padding="5,2" Click="MaxAmmo_OnClick">
                <TextBlock Text="Fill Ammo Stock" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
            </Button>
        </Grid>
    </GroupBox>
    
</UserControl>