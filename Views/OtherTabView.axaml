<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MGSPW_MC_Cheat_Trainer.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MGSPW_MC_Cheat_Trainer.Views.OtherTabView">
    <TabControl x:Name="ItemTabControl" SelectionChanged="ItemTabControl_OnSelectionChanged">
        <TabItem x:Name="KeyItemsTab">
            <TabItem.Header>
                <Panel>
                    <Rectangle x:Name="ImageDarkenerRe" 
                               Fill="Gray" Opacity="0.7" IsHitTestVisible="False"/>
                    <Image Source="/Assets/key_items icon.png" Height="48" Width="48"/>
                </Panel>
            </TabItem.Header>
            <ScrollViewer>
                <Grid x:Name="KeyItemsGrid" ColumnDefinitions=".2*,.2*,.2*,.2*,.2*,.2*,.2*,.2*,.2*,.2*" RowDefinitions=".1*,.3*,.3*,.3*,.3*,.3*,.3*,.3*,.3*,.3*,.3*,.3*,.3*,.3*">
                    <Label x:Name="KeyItemsLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="KEY ITEMS" 
                           Foreground="Black" FontWeight="Bold" FontStretch="Expanded"/>
                    <views:OtherDetailView x:Name="HueyLetterDetailView" Grid.Row="1" Grid.Column="0" PwObject="Huey's Letter" EntityImage="/Assets/letter.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False"/>
                    <views:OtherDetailView x:Name="JigsawDetailView" Grid.Row="1" Grid.Column="1" PwObject="Jigsaw" EntityImage="/Assets/jigsaw.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False"/>
                    <views:OtherDetailView x:Name="IdCardPDetailView" Grid.Row="1" Grid.Column="2" PwObject="ID Card (P)" EntityImage="/Assets/id_card_p.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False"/>
                    <views:OtherDetailView x:Name="EzGunLrDetailView" Grid.Row="1" Grid.Column="3" PwObject="EZ Gun (LR)" EntityImage="/Assets/document.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False"/>
                    <views:OtherDetailView x:Name="EzGunPrDetailView" Grid.Row="1" Grid.Column="4" PwObject="EZ Gun (PR)" EntityImage="/Assets/document.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False"/>
                    <views:OtherDetailView x:Name="PmSpecDetailView" Grid.Row="1" Grid.Column="5" PwObject="PM" EntityImage="/Assets/document.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False"/>
                    <views:OtherDetailView x:Name="Pb6p9DetailView" Grid.Row="1" Grid.Column="6" PwObject="PB/6P9" EntityImage="/Assets/document.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False" />
                    <views:OtherDetailView x:Name="M1911A1DetailView" Grid.Row="1" Grid.Column="7" PwObject="M1911A1" EntityImage="/Assets/document.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False"/>
                    <views:OtherDetailView x:Name="M1911A1CustomDetailView" Grid.Row="1" Grid.Column="8" PwObject="M1911A1 Ct." EntityImage="/Assets/document.png" ValueChanged="RequestStatusBarUpdate" CanStockUp="False"/>
